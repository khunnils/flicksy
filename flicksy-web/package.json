{
  "name": "flicksy-web",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4700",
    "build": "astro build",
    "check": "astro check",
    "test": "vitest run",
    "preview": "astro preview --port 4700",
    "build:test": "CLOUDFLARE_ENV=test astro build",
    "build:production": "CLOUDFLARE_ENV=production astro build",
    "deploy:test": "pnpm build:test && wrangler deploy --config dist/server/wrangler.json",
    "deploy:production": "pnpm build:production && wrangler deploy --config dist/server/wrangler.json",
    "dry-run:test": "pnpm build:test && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "dry-run:production": "pnpm build:production && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.6",
    "astro": "^7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.128.0"
  }
}
