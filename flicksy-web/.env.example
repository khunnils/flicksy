# Copy to .dev.vars for local Cloudflare-backed development.
FLICKSY_ENVIRONMENT=test
FLICKSY_SITE_URL=https://preview.flicksy.me
FLICKSY_DIRECT_DOWNLOAD_URL=https://github.com/khunnils/flicksy/releases/download/test-latest/Flicksy-Test.dmg
FLICKSY_APP_STORE_URL=
CREEM_PRODUCT_ID=prod_2nZWLPHXTxohlTco7vMNl

# Server-only. Use a Creem test key locally and in the GitHub test environment.
CREEM_API_KEY=creem_test_REPLACE_WITH_LOCAL_KEY

# Public TelemetryDeck website app ID. Empty disables analytics.
FLICKSY_TELEMETRYDECK_APP_ID=EA9C901A-3BDD-4943-A617-0357BB5C6BA2
