---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { canonicalURL, serializeJsonLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
}

const { title, description, noindex = false, structuredData = [] } = Astro.props;
const canonical = canonicalURL(Astro.url.pathname);
const imageURL = canonicalURL('/social-preview.jpg');
const excludeFromSearch = noindex || import.meta.env.FLICKSY_DEPLOY_ENV === 'test'
  || (!Astro.isPrerendered && Astro.url.hostname !== 'flicksy.me');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={excludeFromSearch ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/flicksy-app-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Flicksy" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="870" />
    <meta property="og:image:alt" content="Flicksy media browser for Mac showing a visual grid of video clips" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content="Flicksy media browser for Mac showing a visual grid of video clips" />
    {structuredData.length > 0 && <script is:inline type="application/ld+json" set:html={serializeJsonLd({ '@context': 'https://schema.org', '@graph': structuredData })} />}
    <script is:inline>document.documentElement.classList.add('motion-ready');</script>
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
