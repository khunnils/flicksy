---
import Layout from '../layouts/Layout.astro';

const features = [
  { icon: '⌁', title: 'Skim without opening', text: 'Move across any thumbnail to scrub through a clip. The right frame finds you before another player window can open.' },
  { icon: '⌇', title: 'See the sound', text: 'Audio appears as a waveform, ready to play from any point. Find the hit without auditioning a folder of filenames.' },
  { icon: '✦', title: 'Keep the good stuff close', text: 'Favorite, tag, and collect media across folders while every original stays exactly where you put it.' },
  { icon: '↗', title: 'Drag into your editor', text: 'Take a clip straight into Final Cut, Premiere, CapCut, or anywhere else that accepts a file.' },
];

const featureInventory = [
  { icon: '◫', title: 'Browse every media type', text: 'See images, video, and audio together in one fast, visual library.' },
  { icon: '⌗', title: 'Work from real folders', text: 'Browse folders and external drives in place. Nothing is imported, copied, or uploaded.' },
  { icon: '▶', title: 'Scrub video instantly', text: 'Move across a thumbnail to skim a clip before opening a player.' },
  { icon: '≋', title: 'See and trim audio', text: 'Preview waveforms, loop a range, edit tags, and trim a selection in place.' },
  { icon: '◰', title: 'Compare images', text: 'Place up to four images together and change the layout until the best option is obvious.' },
  { icon: '⤢', title: 'Preview and adjust', text: 'Open a focused preview, then crop, rotate, or flip an image without changing apps.' },
  { icon: '★', title: 'Favorites, tags, collections', text: 'Build useful working sets across folders without moving or duplicating originals.' },
  { icon: '⌕', title: 'Search and sort', text: 'Find media by name, filter by type, sort by metadata, and resize the thumbnail grid.' },
  { icon: '⎘', title: 'Clipboard history', text: 'Automatically keep recent copied images ready to browse, reuse, and paste.' },
  { icon: '↗', title: 'Drag into any editor', text: 'Drop media straight into Final Cut, Premiere, CapCut, or any app that accepts files.' },
  { icon: 'ⓘ', title: 'Metadata at a glance', text: 'Inspect dimensions, duration, dates, file size, bit rate, sample rate, and channels.' },
  { icon: '⌘', title: 'Native file actions', text: 'Rename, duplicate, copy, reveal, open with, paste, move, and trash using familiar shortcuts.' },
];

const faqs = [
  { q: 'Does Flicksy import or copy my files?', a: 'No. Flicksy reads the folders already on your Mac and connected drives. Your files and folder structure stay untouched.' },
  { q: 'Is it a photo library or cloud backup?', a: 'Neither. Flicksy is a fast, visual window onto local media. Nothing is uploaded and there is no library to maintain.' },
  { q: 'Which Macs are supported?', a: 'Flicksy is a native Apple Silicon app for macOS 15 and newer.' },
  { q: 'What is included in the trial?', a: 'Everything. Try the complete app, then pay $19 once for a lifetime license with two years of updates included.' },
];
---

<Layout title="Flicksy — A modern media browser for Mac" description="A modern media browser designed for content creators. Browse, compare, organize, and work with images, video, and audio on your Mac.">
  <div class="site-shell" id="top">
    <nav class="nav wrap" aria-label="Main navigation">
      <a class="brand" href="#top" aria-label="Flicksy home">
        <span class="brand-icon"><img src="/flicksy-mark-black.svg" alt="" width="23" height="23" /></span><span>Flicksy</span>
      </a>
      <div class="nav-links"><a href="#how">How it works</a><a href="#features">Features</a><a href="#pricing">Pricing</a></div>
      <a class="button button-small button-dark" href="#pricing">Try Flicksy</a>
    </nav>

    <header class="hero wrap">
      <div class="hero-copy">
        <p class="pill"><span class="apple-mark">●</span> A media browser for content creators</p>
        <h1><strong>Meet Flicksy</strong><span>A modern media browser for Mac</span></h1>
        <p class="hero-lead">Designed for content creators, Flicksy brings every clip, image, and sound into one beautifully fast Mac app. Skim, compare, organize, and drag the right moment straight into your editor.</p>
        <div class="hero-actions">
          <a class="button button-dark" href="#pricing">Download <span>↘</span></a>
          <a class="text-link" href="#how">See how it works <span>↓</span></a>
        </div>
        <p class="fine-print">Full app included · $19 once · 2 years of updates</p>
      </div>

      <div class="iridescent-stage" aria-label="Flicksy app screenshot">
        <span class="aurora aurora-blue"></span><span class="aurora aurora-pink"></span><span class="aurora aurora-mint"></span>
        <div class="app-window hero-window"><img src="/app-browser-dinos.jpeg" alt="Flicksy on macOS showing a visual grid of video clips" width="1784" height="1293" /></div>
      </div>
    </header>
  </div>

  <main>
    <section class="showcase section wrap" id="how">
      <div class="showcase-grid">
        <div class="showcase-copy" data-reveal>
          <p class="eyebrow">Feels at home on Mac</p><h2>A media browser that gets out of your way.</h2>
          <p>No imported library. No alien interface. Flicksy feels familiar from the first click—with a native sidebar, familiar controls, Quick Look speed, and the polish you expect on macOS.</p>
          <ul class="check-list"><li><span>✓</span> Built in Swift for Apple Silicon</li><li><span>✓</span> Reads folders and external drives in place</li><li><span>✓</span> Stays fluid across thousands of assets</li></ul>
        </div>
        <div class="window-wrap" data-reveal data-reveal-delay="1"><div class="app-window detail-window"><img src="/app-browser-history.jpeg" alt="Flicksy browser window showing images and video from a project folder" width="1896" height="1316" /></div></div>
      </div>
    </section>

    <section class="horizon">
      <div class="horizon-orb horizon-orb-a"></div><div class="horizon-orb horizon-orb-b"></div>
      <div class="wrap horizon-content">
        <div class="section-intro light" data-reveal><p class="eyebrow">Made for momentum</p><h2>Keep your hands moving.<br />Keep your ideas intact.</h2><p>Every part of Flicksy is tuned to shorten the distance between “I know I have it” and “there it is.” Quick Jump gets you to any folder or collection fast, while the ⌘K command palette keeps every action within reach.</p></div>
        <div class="feature-grid">{features.map((feature, index) => <article class="glass-card" data-reveal data-reveal-delay={String(index % 4)}><span class="feature-icon">{feature.icon}</span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div>
        <div class="preview-card">
          <div class="preview-copy" data-reveal><p class="eyebrow">Built-in adjustments</p><h3>Stay in the flow, even for the little fixes.</h3><p>Preview, rotate, and flip an image, or crop with standardized guides for common print formats—all without leaving your media browser.</p></div>
          <div class="app-window preview-window" data-reveal data-reveal-delay="1"><img src="/app-preview-crop.jpeg" alt="Flicksy image preview with native macOS crop controls" width="1784" height="1154" /></div>
        </div>
        <div class="preview-card comparison-card">
          <div class="preview-copy" data-reveal data-reveal-delay="1"><p class="eyebrow">Made to compare</p><h3>Choose the best shot, without the window shuffle.</h3><p>Finder can select images. Preview can open them. Flicksy lets you compare them in sensible layouts..</p></div>
          <div class="app-window comparison-window" data-reveal><img src="/app-compare.jpeg" alt="Flicksy comparing four images side by side in a native macOS window" width="3562" height="2608" /></div>
        </div>
      </div>
    </section>

    <section class="section organize wrap">
      <div class="section-intro center" data-reveal><p class="eyebrow">A layer, not a lock-in</p><h2>Organize the way you think.<br />Keep files where they belong.</h2></div>
      <div class="organize-grid">
        <article class="soft-card tags-card" data-reveal><div class="mini-ui tag-cloud"><span><i class="purple"></i> Dinos <em>21</em></span><span><i class="red"></i> Thumbnails <em>8</em></span><span><i class="blue"></i> Approved <em>14</em></span></div><div><h3>Tags that travel</h3><p>Label media across folders, then see every matching item together.</p></div></article>
        <article class="soft-card collections-card" data-reveal data-reveal-delay="1"><div class="mini-ui collection-list"><span><b>▦</b> Episode 12 <em>34</em></span><span><b>▦</b> Spring launch <em>18</em></span><span><b>▦</b> Best openers <em>9</em></span></div><div><h3>Collections without copies</h3><p>Build working sets across projects while every original stays put.</p></div></article>
        <article class="soft-card favorites-card" data-reveal data-reveal-delay="2"><div class="mini-ui favorite-ui"><span>★</span><small>Your best takes,<br />always one click away.</small></div><div><h3>Favorites at hand</h3><p>Save the shots worth returning to with a single keystroke.</p></div></article>
      </div>
    </section>

    <section class="section feature-inventory" id="features">
      <div class="wrap">
        <div class="section-intro inventory-intro" data-reveal><p class="eyebrow">The full toolkit</p><h2>Everything you expect.<br />Plus what Finder is missing.</h2><p>Flicksy combines everyday file browsing with the media-first tools content creators reach for all day.</p></div>
        <div class="inventory-grid">
          {featureInventory.map((feature, index) => (
            <article class="inventory-item" data-reveal data-reveal-delay={String(index % 3)}>
              <span class="inventory-icon" aria-hidden="true">{feature.icon}</span>
              <div><h3>{feature.title}</h3><p>{feature.text}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section pricing" id="pricing">
      <div class="wrap pricing-grid">
        <div class="pricing-copy" data-reveal><p class="eyebrow">Simple by design</p><h2>One tiny price.<br />One less subscription.</h2><p>Try the whole app free. Pay once only if Flicksy earns a place in your Dock.</p><div class="compatibility"><span>●</span> macOS 15+ · Apple Silicon</div></div>
        <div class="price-card" data-reveal data-reveal-delay="1">
          <div class="price-top"><img src="/flicksy-app-icon.png" alt="Flicksy app icon" width="72" height="72" /><span>Lifetime license</span></div>
          <div class="price-line"><strong>$19</strong><span>USD<br />one-time</span></div>
          <ul><li>Lifetime license</li><li>Two years of updates included</li><li>Video, images, and audio</li><li>Tags, collections, and favorites</li><li>No account, upload, or lock-in</li></ul>
          <a class="button button-dark button-wide" href="#">Download <span>↓</span></a>
        </div>
      </div>
    </section>

    <section class="section faq wrap">
      <div class="section-intro" data-reveal><p class="eyebrow">Good to know</p><h2>Straight answers.</h2></div>
      <div class="faq-grid">{faqs.map((item, index) => <article data-reveal data-reveal-delay={String(index % 2)}><h3>{item.q}</h3><p>{item.a}</p></article>)}</div>
    </section>
  </main>

  <footer class="footer"><div class="wrap footer-inner"><a class="brand" href="#top"><span class="brand-icon"><img src="/flicksy-mark-black.svg" alt="" width="23" height="23" /></span><span>Flicksy</span></a><p>Made for creators who would rather be making.</p><span>© 2026 Flicksy</span></div></footer>
</Layout>

<style>
  .site-shell { position: relative; overflow: clip; }
  .nav { position: relative; z-index: 20; display: flex; align-items: center; gap: 34px; height: 76px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 650; letter-spacing: -.025em; }
  .brand-icon { width: 35px; height: 35px; border-radius: 11px; display: grid; place-items: center; background: rgba(255,255,255,.72); border: 1px solid rgba(255,255,255,.9); box-shadow: 0 4px 16px rgba(28,37,52,.08), inset 0 0 0 1px rgba(120,130,145,.08); backdrop-filter: blur(16px); }
  .brand-icon img { width: 21px; height: 21px; }
  .nav-links { margin-left: auto; display: flex; gap: 27px; }
  .nav-links a { color: var(--muted); text-decoration: none; font-size: 13px; transition: color .2s; }
  .nav-links a:hover { color: var(--ink); }
  .button-small { padding: 9px 16px !important; font-size: 13px !important; }
  .hero { position: relative; padding-top: 76px; text-align: center; }
  .hero-copy { position: relative; z-index: 2; max-width: 780px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; }
  .hero-copy > * { animation: hero-enter .8s cubic-bezier(.22,1,.36,1) both; }
  .hero-copy > :nth-child(1) { animation-delay: .08s; }
  .hero-copy > :nth-child(2) { animation-delay: .15s; }
  .hero-copy > :nth-child(3) { animation-delay: .23s; }
  .hero-copy > :nth-child(4) { animation-delay: .31s; }
  .hero-copy > :nth-child(5) { animation-delay: .39s; }
  .pill { display: inline-flex; align-items: center; gap: 8px; margin: 0; padding: 7px 13px; background: rgba(255,255,255,.58); border: 1px solid rgba(255,255,255,.85); box-shadow: inset 0 0 0 1px rgba(100,110,130,.06), 0 8px 28px rgba(82,92,120,.08); border-radius: 999px; color: #626a79; font-size: 12px; backdrop-filter: blur(18px); }
  .apple-mark { color: #20242b; font-size: 8px; }
  .hero h1 { margin: 25px 0 23px; display: flex; flex-direction: column; gap: 12px; line-height: .92; letter-spacing: -.065em; }
  .hero h1 strong { font-size: clamp(66px, 9.3vw, 116px); font-weight: 650; }
  .hero h1 span { max-width: 840px; color: #626a76; font-size: clamp(34px, 5vw, 62px); font-weight: 420; letter-spacing: -.055em; }
  .hero-lead { max-width: 625px; margin: 0; color: var(--muted); font-size: clamp(17px, 2vw, 20px); line-height: 1.55; }
  .hero-actions { display: flex; align-items: center; gap: 25px; margin-top: 30px; }
  .text-link { display: inline-flex; gap: 8px; align-items: center; font-size: 14px; text-underline-offset: 4px; text-decoration-color: #c5c9d0; }
  .fine-print { margin: 15px 0 0; color: #969ba5; font-size: 11.5px; }
  .iridescent-stage { position: relative; margin: 82px -52px 0; min-height: 650px; padding: 70px 64px 120px; isolation: isolate; }
  .iridescent-stage::before {
    content: ''; position: absolute; z-index: -3; inset: -90px -24vw 0;
    background:
      radial-gradient(ellipse 45% 62% at 12% 51%, rgba(83, 139, 255, .78), transparent 72%),
      radial-gradient(ellipse 42% 58% at 88% 49%, rgba(248, 102, 190, .68), transparent 72%),
      radial-gradient(ellipse 43% 48% at 53% 91%, rgba(72, 218, 190, .65), transparent 74%),
      radial-gradient(ellipse 34% 42% at 54% 35%, rgba(164, 119, 255, .55), transparent 74%),
      linear-gradient(180deg, rgba(247,248,251,0) 0%, #e9eefb 34%, #eef4f5 100%);
    border-radius: 50% 50% 0 0 / 16% 16% 0 0;
  }
  .iridescent-stage::after {
    content: ''; position: absolute; z-index: -1; inset: auto -24vw 0; height: 155px;
    background: linear-gradient(180deg, transparent 0%, rgba(247,248,250,.72) 58%, var(--bg) 100%);
    pointer-events: none;
  }
  .aurora { position: absolute; z-index: -2; border-radius: 50%; filter: blur(32px); mix-blend-mode: multiply; opacity: .56; }
  .aurora-blue { width: 600px; height: 420px; left: -80px; top: 105px; background: #73a4ff; animation: aurora-blue 16s ease-in-out infinite alternate; }
  .aurora-pink { width: 560px; height: 400px; right: -40px; top: 120px; background: #ef8bce; animation: aurora-pink 19s ease-in-out infinite alternate; }
  .aurora-mint { width: 590px; height: 310px; left: 34%; bottom: 20px; background: #72dac8; animation: aurora-mint 17s ease-in-out infinite alternate; }
  .app-window { position: relative; overflow: visible; border: 0; background: transparent; box-shadow: none; }
  .app-window img {
    width: 100%; height: 100%; object-fit: cover;
    clip-path: inset(2.6% 3% 5.4% 3% round 22px);
    filter: drop-shadow(0 36px 34px rgba(34, 43, 61, .24)) drop-shadow(0 8px 12px rgba(34, 43, 61, .14));
  }
  .hero-window { transform: perspective(1600px) rotateX(2deg); animation: window-enter 1s .32s cubic-bezier(.22,1,.36,1) both; }
  .center { margin-left: auto; margin-right: auto; text-align: center; }
  .showcase { position: relative; z-index: 2; margin-top: -72px; padding-top: 180px; padding-bottom: 140px; }
  .showcase-grid { display: grid; grid-template-columns: .78fr 1.45fr; align-items: center; gap: 70px; }
  .showcase-copy h2 { margin: 15px 0 22px; font-size: clamp(38px, 4.4vw, 58px); }
  .showcase-copy > p:not(.eyebrow) { color: var(--muted); font-size: 16px; }
  .check-list { list-style: none; padding: 0; margin: 29px 0 0; }
  .check-list li { display: flex; gap: 10px; align-items: center; padding: 10px 0; border-top: 1px solid var(--line); font-size: 13px; }
  .check-list span { color: #557868; }
  .window-wrap { position: relative; }
  .window-wrap::before { content: ''; position: absolute; inset: -70px -80px; z-index: -1; border-radius: 50%; background: radial-gradient(circle, rgba(221,232,255,.8), rgba(243,225,242,.35) 45%, transparent 72%); }
  .detail-window { transform: rotate(1deg); }
  .detail-window img { clip-path: inset(2.7% 3% 5.2% 3% round 18px); }
  .horizon { position: relative; overflow: hidden; padding: 125px 0 0; background: #1c2530; color: #f7f9fb; isolation: isolate; }
  .horizon::after { content: ''; position: absolute; inset: auto 0 0; height: 34%; z-index: -1; background: linear-gradient(180deg, transparent, rgba(14,20,28,.35)); }
  .horizon-orb { position: absolute; z-index: -2; border-radius: 50%; }
  .horizon-orb-a { width: 900px; height: 900px; top: -610px; right: -190px; background: #25313f; }
  .horizon-orb-b { width: 900px; height: 700px; left: -350px; top: 290px; background: #2d4354; }
  .horizon-content { position: relative; }
  .light { max-width: 690px; } .light .eyebrow, .light p { color: #9eaeba; } .light h2 { margin: 16px 0 22px; }
  .feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 55px; }
  .glass-card { min-height: 270px; padding: 25px; border: 1px solid rgba(255,255,255,.11); border-radius: 22px; background: rgba(255,255,255,.055); box-shadow: inset 0 1px 0 rgba(255,255,255,.06); backdrop-filter: blur(20px); transition: transform .35s cubic-bezier(.22,1,.36,1), border-color .35s ease, background .35s ease, box-shadow .35s ease; }
  .glass-card:hover { transform: translateY(-4px); border-color: rgba(255,255,255,.18); background: rgba(255,255,255,.075); box-shadow: inset 0 1px 0 rgba(255,255,255,.08), 0 18px 45px rgba(5,11,18,.12); }
  .feature-icon { width: 38px; height: 38px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.14); border-radius: 12px; background: rgba(255,255,255,.08); color: #dbe9f3; font-size: 18px; }
  .glass-card h3 { margin: 58px 0 10px; font-size: 17px; } .glass-card p { margin: 0; color: #9eacb8; font-size: 13px; line-height: 1.6; }
  .preview-card { display: grid; grid-template-columns: .68fr 1.55fr; align-items: center; gap: 58px; margin-top: 110px; }
  .preview-copy h3 { margin: 13px 0; font-size: clamp(28px, 3.5vw, 43px); line-height: 1.05; letter-spacing: -.04em; }
  .preview-copy > p:not(.eyebrow) { color: #a6b2bd; }
  .preview-window { align-self: end; }
  .preview-window img { clip-path: inset(3.1% 3.1% 6.2% 3.1% round 19px); filter: drop-shadow(0 38px 32px rgba(0,0,0,.35)) drop-shadow(0 8px 12px rgba(0,0,0,.2)); }
  .comparison-card { grid-template-columns: 1.55fr .68fr; padding-bottom: 125px; }
  .comparison-card .preview-copy { order: 2; }
  .comparison-card .comparison-window { order: 1; }
  .comparison-window img { height: auto; object-fit: contain; clip-path: inset(3.1% 3.1% 6.2% 3.1% round 19px); filter: drop-shadow(0 38px 32px rgba(0,0,0,.35)) drop-shadow(0 8px 12px rgba(0,0,0,.2)); }
  .organize { padding-top: 130px; }
  .organize-grid { margin-top: 58px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
  .soft-card { display: flex; flex-direction: column; min-height: 440px; padding: 16px; border: 1px solid rgba(132,143,158,.17); background: rgba(255,255,255,.7); border-radius: 25px; box-shadow: 0 20px 50px rgba(46,57,75,.06); transition: transform .35s cubic-bezier(.22,1,.36,1), box-shadow .35s ease, border-color .35s ease; }
  .soft-card:hover { transform: translateY(-4px); border-color: rgba(132,143,158,.26); box-shadow: 0 26px 65px rgba(46,57,75,.1); }
  .soft-card > div:last-child { padding: 20px 10px 10px; } .soft-card h3 { margin: 0 0 7px; font-size: 18px; } .soft-card p { margin: 0; color: var(--muted); font-size: 13px; }
  .mini-ui { flex: 1; border-radius: 17px; background: #eef1f5; }
  .tag-cloud, .collection-list { display: flex; flex-direction: column; justify-content: center; gap: 8px; padding: 28px; }
  .tag-cloud span, .collection-list span { display: flex; align-items: center; gap: 9px; padding: 10px 12px; background: rgba(255,255,255,.86); border: 1px solid rgba(132,143,158,.16); border-radius: 11px; font-size: 12px; box-shadow: 0 4px 12px rgba(36,44,56,.03); }
  .tag-cloud em, .collection-list em { margin-left: auto; color: #9aa0a9; font-style: normal; font-size: 10px; }
  .tag-cloud i { width: 8px; height: 8px; border-radius: 50%; }
  .purple { background: #a92aca; } .red { background: #ee3a45; } .blue { background: #3578e8; }
  .collection-list b { color: #727985; font-weight: 500; }
  .favorite-ui { display: flex; flex-direction: column; align-items: center; justify-content: center; background: radial-gradient(circle at 50% 38%, #fff 0, #eef2f6 55%, #e9edf2 100%); text-align: center; }
  .favorite-ui span { font-size: 58px; color: #1f2329; filter: drop-shadow(0 8px 15px rgba(30,36,46,.15)); }
  .favorite-ui small { margin-top: 17px; color: #8a929e; line-height: 1.55; }
  .feature-inventory { background: #eef1f5; }
  .inventory-intro { max-width: 770px; }
  .inventory-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 60px; border-top: 1px solid #d5dae1; border-left: 1px solid #d5dae1; border-radius: 22px; overflow: hidden; }
  .inventory-item { display: flex; gap: 17px; min-height: 178px; padding: 27px 25px; border-right: 1px solid #d5dae1; border-bottom: 1px solid #d5dae1; background: rgba(255,255,255,.5); }
  .inventory-icon { flex: none; width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid #d3d8df; border-radius: 11px; background: #fff; color: #596271; font-size: 16px; box-shadow: 0 4px 12px rgba(36,44,56,.05); }
  .inventory-item h3 { margin: 3px 0 8px; font-size: 15px; }
  .inventory-item p { margin: 0; color: var(--muted); font-size: 12.5px; line-height: 1.58; }
  .pricing { background: linear-gradient(135deg, #eef3ff 0%, #f5eff7 48%, #eaf5f2 100%); }
  .pricing-grid { display: grid; grid-template-columns: 1fr 440px; align-items: center; gap: 90px; }
  .pricing-copy h2 { margin: 15px 0 22px; font-size: clamp(44px, 5vw, 68px); }
  .pricing-copy > p:not(.eyebrow) { max-width: 490px; color: var(--muted); font-size: 17px; }
