<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Read-write so the user can move media to the Trash (Finder-style delete).
	     Without this the sandbox denies FileManager.trashItem on selected folders. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Required for security-scoped bookmarks to persist folder access across launches.
	     There is no Xcode build setting that emits this key, so it must live here. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
